---
// The gallery. Markup and styles live in one component per section; behaviour
// is in scripts/app.js and the feature modules it wires up. Component order
// here is also the order their <style> blocks land in the built stylesheet,
// after global.css.
import GalleryLayout from '../layouts/GalleryLayout.astro';
import IconSprite from '../components/IconSprite.astro';
import IntroSplash from '../components/IntroSplash.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import Controls from '../components/Controls.astro';
import MapView from '../components/MapView.astro';
import GrowthView from '../components/GrowthView.astro';
import LocationGrid from '../components/LocationGrid.astro';
import Lightbox from '../components/Lightbox.astro';
import Slideshow from '../components/Slideshow.astro';
import TeamModal from '../components/TeamModal.astro';
import SiteFooter from '../components/SiteFooter.astro';
import IncidentVideos from '../components/IncidentVideos.astro';
import SalesPanel from '../components/SalesPanel.astro';
---
<GalleryLayout>

{/* ══ ICONS ═══════════════════════════════════════
     Sprite + ic() helper, shared with admin.html. */}
<IconSprite />

<IntroSplash />
<SiteHeader />
<Hero />
<Controls />
<MapView />
<GrowthView />
<LocationGrid />
<Lightbox />
<Slideshow />
<TeamModal />
<SiteFooter />
<IncidentVideos />
<SalesPanel />

<script src="../scripts/app.js"></script>
</GalleryLayout>
