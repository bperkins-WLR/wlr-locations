---
// Bottom-sheet roster for one location; scripts/team-modal.js fills it.
---
<!-- ══ TEAM MODAL ══════════════════════════════════════════ -->
<div class="team-overlay" id="teamOverlay"></div>
<div class="team-panel" id="teamPanel">
  <div class="team-handle"></div>
  <div class="team-header">
    <div class="team-header-text">
      <div class="team-title" id="teamPanelTitle"></div>
      <div class="team-subtitle" id="teamPanelSubtitle"></div>
    </div>
    <button class="team-close" id="teamClose"><svg class="ico" aria-hidden="true"><use href="#i-x"></use></svg></button>
  </div>
  <div class="team-body" id="teamPanelBody"></div>
</div>

<style is:global>
/* ══ TEAM MODAL ════════════════════════════════════════ */
.team-overlay {
  display: none; position: fixed; inset: 0;
  background: rgba(0,0,0,0.55); z-index: 800;
  /* Prefixed first: the CSS minifier drops a standard declaration that is
     followed by its -webkit- twin, which cost desktop Chrome the blur. */
  -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px);
}
.team-overlay.open { display: block; }
.team-panel {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: linear-gradient(170deg, #102f6b 0%, #0a1f45 100%);
  border-top: 3px solid var(--yellow);
  border-radius: 20px 20px 0 0;
  padding-bottom: max(env(safe-area-inset-bottom), 24px);
  z-index: 801; max-height: 78vh; overflow-y: auto;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.32,0.72,0,1);
}
.team-panel.open { transform: translateY(0); }
.team-handle { width: 36px; height: 4px; background: rgba(255,255,255,0.25); border-radius: 2px; margin: 12px auto 4px; }
.team-header { padding: 10px 20px 14px; border-bottom: 1px solid rgba(255,255,255,0.1); display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
.team-header-text { flex: 1; min-width: 0; }
.team-title { font-size: 16px; font-weight: 800; color: #fff; line-height: 1.2; }
.team-subtitle { font-size: 11px; color: rgba(255,255,255,0.5); margin-top: 3px; letter-spacing: 0.3px; }
.team-close { width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; font-size: 16px; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.team-body { padding: 16px 20px 4px; display: flex; flex-direction: column; gap: 0; }
.team-row { padding: 11px 0; border-bottom: 1px solid rgba(255,255,255,0.07); }
.team-row:last-child { border-bottom: none; }
.team-role { font-size: 9px; font-weight: 800; color: var(--yellow); text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 4px; }
.team-name { font-size: 14px; font-weight: 600; color: #fff; line-height: 1.5; }
.team-name.open { color: rgba(255,255,255,0.35); font-style: italic; font-size: 13px; }
</style>
