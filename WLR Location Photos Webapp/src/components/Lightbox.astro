---
// Full-screen photo viewer; scripts/lightbox.js drives it.
---
<!-- ══ LIGHTBOX ════════════════════════════════════════ -->
<div class="lightbox" id="lightbox">
  <button class="lightbox-close" id="lightboxClose"><svg class="ico" aria-hidden="true"><use href="#i-x"></use></svg></button>
  <button class="lb-arrow" id="lbPrev">‹</button>
  <picture>
    <source id="lbAvif" type="image/avif" media="(max-width: 900px)" sizes="100vw">
    <source id="lbWebp" type="image/webp" media="(max-width: 900px)" sizes="100vw">
    <img id="lightboxImg" src="" alt="">
  </picture>
  <div class="lb-dots" id="lbDots"></div>
  <button class="lb-arrow" id="lbNext">›</button>
  <div class="lightbox-caption" id="lightboxCaption"></div>
</div>

<style is:global>
/* ══ LIGHTBOX ════════════════════════════════════════ */
.lightbox {
  display: none; position: fixed; inset: 0;
  background: linear-gradient(160deg, rgba(12,44,90,0.98) 0%, rgba(7,26,56,0.98) 100%); z-index: 1000;
  flex-direction: column; align-items: center; justify-content: center;
  padding: 16px;
}
.lightbox.open { display: flex; animation: lbIn 0.18s ease; }

/* ══ VIEW TRANSITIONS ════════════════════════════════
   The tapped card photo morphs into (and back out of) the lightbox
   rather than hard-cutting. Progressive enhancement: browsers without
   the API keep the old lbIn fade and behave exactly as before.

   #lightboxImg holds the shared name permanently — it only participates
   while the lightbox is rendered, so it can never collide with the
   thumbnail, which is tagged only for the duration of a transition. */
#lightboxImg { view-transition-name: lb-photo; }

@supports (view-transition-name: none) {
  /* The overlay's own entrance would be captured mid-flight by the
     transition snapshot, which reads as a flash. The morph plus the
     root cross-fade already cover the entrance. */
  .lightbox.open { animation: none; }

  ::view-transition-group(lb-photo) {
    animation-duration: var(--t-slow);
    animation-timing-function: var(--ease);
  }
  /* Both snapshots fill the morphing box, so the crop change
     (thumbnails cover-crop off-centre, lightbox contains the whole
     frame) cross-fades instead of squashing. */
  ::view-transition-old(lb-photo),
  ::view-transition-new(lb-photo) {
    width: 100%; height: 100%; object-fit: cover;
    animation-duration: var(--t-slow);
    animation-timing-function: var(--ease);
  }
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: var(--t-base);
    animation-timing-function: var(--ease);
  }
}

@media (prefers-reduced-motion: reduce) {
  ::view-transition-group(*),
  ::view-transition-old(*),
  ::view-transition-new(*) { animation: none !important; }
}
@keyframes lbIn { from { opacity:0; transform:scale(0.96); } to { opacity:1; transform:scale(1); } }

.lightbox picture { display: contents; }
.lightbox img {
  max-width: 100%; max-height: calc(100vh - 110px);
  width: auto; height: auto;
  object-fit: contain; border-radius: 10px;
  box-shadow: 0 8px 40px rgba(0,0,0,.6);
  touch-action: pinch-zoom; user-select: none;
  transition: opacity 0.15s;
}

/* Prev / Next arrows */
.lb-arrow {
  position: absolute; top: 50%; transform: translateY(-50%);
  width: 44px; height: 44px; border-radius: 50%;
  background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);
  backdrop-filter: blur(8px); color: #fff;
  font-size: 20px; cursor: pointer; display: flex; align-items: center; justify-content: center;
  z-index: 10; transition: background 0.15s;
}
.lb-arrow:active { background: rgba(255,255,255,0.3); }
.lb-arrow.hidden { opacity: 0.2; pointer-events: none; }
#lbPrev { left: 12px; }
#lbNext { right: 12px; }

/* Dot indicators */
.lb-dots { display: flex; gap: 6px; margin-top: 10px; }
.lb-dot  { width: 7px; height: 7px; border-radius: 50%; background: rgba(255,255,255,0.3); transition: background 0.2s; }
.lb-dot.active { background: var(--yellow); }

/* Caption */
.lightbox-caption {
  position: absolute; bottom: 0; left: 0; right: 0;
  padding: 14px 70px 20px;
  background: linear-gradient(transparent, rgba(0,0,0,0.85));
  font-size: 13px; color: rgba(255,255,255,0.85);
  text-align: center; letter-spacing: 0.3px;
}
/* Close */
.lightbox-close {
  position: absolute; top: max(env(safe-area-inset-top), 16px); right: 16px;
  background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);
  backdrop-filter: blur(8px); color: #fff; font-size: 18px;
  width: 44px; height: 44px; border-radius: 50%; cursor: pointer;
  display: flex; align-items: center; justify-content: center; z-index: 10;
}

/* — Lightbox open: improved slide-up — */
@keyframes lbIn {
  from { opacity: 0; transform: scale(0.92) translateY(24px); }
  to   { opacity: 1; transform: scale(1)    translateY(0); }
}

/* — Lightbox photo cross-fade on slide change — */
@keyframes photoSlideIn {
  from { opacity: 0.1; transform: scale(0.96); }
  to   { opacity: 1;   transform: scale(1); }
}
#lightboxImg.slide-in {
  animation: photoSlideIn 0.3s cubic-bezier(0.22, 1, 0.36, 1) both;
}
</style>
