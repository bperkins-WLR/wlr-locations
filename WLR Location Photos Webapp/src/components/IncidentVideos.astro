---
// Videos overlay and player; scripts/incidents.js fills them.
---
<!-- ══ VIDEOS ═══════════════════════════════════════════════ -->
<div class="inc-overlay" id="incOverlay">
  <div class="inc-head">
    <div class="inc-title"><svg class="ico" aria-hidden="true"><use href="#i-video"></use></svg>Videos</div>
    <button class="inc-close" id="incClose" title="Close"><svg class="ico" aria-hidden="true"><use href="#i-x"></use></svg></button>
  </div>
  <div class="inc-grid" id="incGrid"></div>
  <div class="inc-empty" id="incEmpty">No videos yet.</div>
</div>
<div class="inc-player" id="incPlayer">
  <div class="inc-player-bar">
    <span class="inc-player-title" id="incPlayerTitle"></span>
    <button class="inc-player-close" id="incPlayerClose" title="Close"><svg class="ico" aria-hidden="true"><use href="#i-x"></use></svg></button>
  </div>
  <div class="inc-player-body" id="incPlayerBody"></div>
</div>

<style is:global>
/* ══ INCIDENT VIDEOS ═════════════════════════════════ */
.inc-overlay { display: none; position: fixed; inset: 0; z-index: 950;
  background: linear-gradient(160deg, #0c2c5a 0%, #071a38 100%); flex-direction: column; }
.inc-overlay.open { display: flex; }
.inc-head { display: flex; align-items: center; gap: 10px; padding: max(env(safe-area-inset-top),12px) 16px 12px; border-bottom: 1px solid rgba(255,255,255,0.12); }
.inc-title { font-size: 18px; font-weight: 800; color: #fff; flex: 1; }
.inc-headbtn { padding: 7px 13px; border-radius: 9px; background: var(--yellow); border: none; color: var(--deep); font-size: 13px; font-weight: 800; cursor: pointer; }
.inc-close { width: 34px; height: 34px; border-radius: 50%; background: rgba(255,255,255,0.12); border: none; color: #fff; font-size: 17px; cursor: pointer; }
.inc-form { padding: 14px 16px; border-bottom: 1px solid rgba(255,255,255,0.1); display: flex; flex-direction: column; gap: 9px; background: rgba(0,0,0,0.18); }
.inc-form[hidden] { display: none; }
.inc-form-row { display: flex; gap: 9px; }
.inc-in { width: 100%; padding: 9px 11px; border-radius: 9px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; font-size: 14px; font-family: inherit; outline: none; }
.inc-in::placeholder { color: rgba(255,255,255,0.45); }
.inc-in:focus { border-color: var(--yellow); background: rgba(255,255,255,0.15); }
.inc-form-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
.inc-save { padding: 8px 16px; border-radius: 9px; background: var(--yellow); border: none; color: var(--deep); font-weight: 800; font-size: 13px; cursor: pointer; }
.inc-cancel { padding: 8px 14px; border-radius: 9px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); color: #fff; font-size: 13px; font-weight: 700; cursor: pointer; }
.inc-publish { margin-left: auto; padding: 8px 13px; border-radius: 9px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.85); font-size: 12px; font-weight: 700; cursor: pointer; }
.inc-hint { font-size: 11px; color: rgba(255,255,255,0.5); line-height: 1.4; }
.inc-grid { flex: 1; overflow-y: auto; -webkit-overflow-scrolling: touch; padding: 16px; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; align-content: start; }
.inc-empty { display: none; flex: 1; align-items: center; justify-content: center; color: rgba(255,255,255,0.55); font-size: 14px; text-align: center; padding: 30px; }
.inc-overlay.empty .inc-grid { display: none; }
.inc-overlay.empty .inc-empty { display: flex; }
.inc-card { text-align: left; background: rgba(0,0,0,0.28); border: 1px solid rgba(255,255,255,0.14); border-radius: 13px; overflow: hidden; cursor: pointer; padding: 0; transition: transform 0.12s, border-color 0.12s; }
.inc-card:hover { transform: translateY(-2px); border-color: rgba(255,255,255,0.3); }
.inc-thumb { position: relative; aspect-ratio: 16/9; background: #061528; display: flex; align-items: center; justify-content: center; }
.inc-thumb img { width: 100%; height: 100%; object-fit: cover; }
.inc-poster { font-size: 40px; opacity: 0.5; }
.inc-play { position: absolute; width: 46px; height: 46px; border-radius: 50%; background: rgba(12,44,90,0.78); border: 2px solid rgba(255,255,255,0.85); color: #fff; font-size: 17px; display: flex; align-items: center; justify-content: center; padding-left: 3px; }
.inc-draft { position: absolute; top: 7px; left: 7px; background: var(--yellow); color: var(--deep); font-size: 9px; font-weight: 800; padding: 2px 6px; border-radius: 4px; text-transform: uppercase; letter-spacing: 0.5px; }
.inc-meta { padding: 9px 11px 11px; }
.inc-vtitle { font-size: 13px; font-weight: 800; color: #fff; line-height: 1.25; }
.inc-vsub { font-size: 11px; color: rgba(255,255,255,0.55); margin-top: 3px; }
.inc-vloc { color: var(--yellow); }

.inc-player { display: none; position: fixed; inset: 0; z-index: 980; background: rgba(4,14,30,0.97); flex-direction: column; }
.inc-player.open { display: flex; }
.inc-player-bar { display: flex; align-items: center; gap: 12px; padding: max(env(safe-area-inset-top),12px) 16px 12px; }
.inc-player-title { flex: 1; color: #fff; font-size: 14px; font-weight: 700; }
.inc-player-close { width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,0.14); border: none; color: #fff; font-size: 18px; cursor: pointer; }
.inc-player-body { flex: 1; display: flex; align-items: center; justify-content: center; padding: 0 16px 20px; }
.inc-player-body iframe, .inc-player-body video { width: 100%; max-width: 1100px; aspect-ratio: 16/9; height: auto; max-height: 100%; border: none; border-radius: 12px; background: #000; }
</style>
