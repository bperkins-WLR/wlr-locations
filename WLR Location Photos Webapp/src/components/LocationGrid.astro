---
// The location card grid. Cards are generated by scripts/grid.js, so every
// rule here is global — Astro's scoped styles would never reach them.
---
<div class="grid" id="grid"></div>
<div class="no-results" id="noResults">
  <div class="no-results-icon"><svg class="ico" aria-hidden="true"><use href="#i-search"></use></svg></div>
  <p>No locations found.</p>
</div>

<style is:global>
/* ══ GRID ════════════════════════════════════════════ */
.grid { padding: 12px 12px 90px; display: grid; grid-template-columns: 1fr; gap: 14px; max-width: 560px; margin: 0 auto; }
@media(min-width: 560px)  { .grid { grid-template-columns: 1fr 1fr; } }
@media(min-width: 1100px) { .grid { max-width: 1320px; grid-template-columns: repeat(3, 1fr); gap: 18px; padding: 18px 18px 100px; } }
@media(min-width: 1500px) { .grid { max-width: 1720px; grid-template-columns: repeat(4, 1fr); gap: 20px; } }

/* The map popup's "Photos" button lands on the card with a brief yellow ring */
.card.flash { animation: cardFlash 1.6s ease; }
@keyframes cardFlash {
  0%, 100% { box-shadow: 0 5px 22px rgba(0,0,0,.6); }
  25%, 60% { box-shadow: 0 0 0 3px var(--yellow), 0 5px 22px rgba(0,0,0,.6); }
}

/* ══ CARD ════════════════════════════════════════════ */
.card {
  background: linear-gradient(145deg, #0d0d0d 0%, #050505 100%);
  border-radius: 16px; overflow: hidden;
  border: 1px solid rgba(255,255,255,0.14);
  box-shadow: 0 5px 22px rgba(0,0,0,.6);
  transition: transform 0.15s;
}
.card:active { transform: scale(0.983); }
.card.hidden { display: none; }

.card-stripe { display: none; }

.card-header { display: flex; align-items: stretch; padding: 0; gap: 0; border-bottom: 1px solid rgba(255,255,255,0.1); }

/* ── LOGO COLUMN (left side, brand color bg) ── */
.logo-col {
  width: 76px; flex-shrink: 0;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 6px;
  padding: 14px 8px;
  text-align: center;
}
.num-bar-TLC, .num-bar-TAS, .num-bar-TAR, .num-bar-TASE { background: transparent; border-right: 1px solid rgba(255,255,255,0.08); }

.brand-logo { height: 40px; width: auto; max-width: 60px; object-fit: contain; display: block; }
.type-badge { padding: 4px 9px; border-radius: 7px; font-size: 11px; font-weight: 800; letter-spacing: 0.4px; text-transform: uppercase; white-space: nowrap; color: #ffffff; }

.years-badge {
  font-size: 12.5px; font-weight: 800; line-height: 1.1;
  padding: 3px 8px; border-radius: 5px; display: inline-block; white-space: nowrap;
}
.yb-new  { background: rgba(0,0,0,0.3); color: #ffffff; }
.yb-old  { background: rgba(0,0,0,0.28); color: var(--yellow); }

.loc-info  { flex: 1; min-width: 0; padding: 11px 12px; display: flex; flex-direction: column; justify-content: center; }
.loc-title-row { display: flex; align-items: center; gap: var(--s-2); }
.loc-title-row .loc-name { flex: 1; min-width: 0; }
.loc-share {
  flex: none; display: inline-flex; align-items: center; justify-content: center;
  width: 26px; height: 26px; margin: -2px -4px -2px 0;
  background: none; border: none; border-radius: var(--r-sm);
  color: rgba(255,255,255,0.4); cursor: pointer; -webkit-appearance: none;
  transition: color var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
}
.loc-share:active { background: rgba(255,255,255,0.14); color: #fff; }
@media (hover: hover) { .loc-share:hover { color: #fff; background: rgba(255,255,255,0.10); } }

/* Landing from a ?loc= link: draw the eye to the right card without
   yanking anything around. */
@keyframes cardFocus {
  0%   { box-shadow: 0 0 0 0 rgba(250,220,0,0.0); }
  15%  { box-shadow: 0 0 0 3px rgba(250,220,0,0.85); }
  100% { box-shadow: 0 0 0 3px rgba(250,220,0,0.0); }
}
.card.card-focus { animation: cardFocus 2.4s ease-out both; }


.loc-name  { font-size: 14px; font-weight: 700; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: default; }
.loc-name.has-overflow { cursor: pointer; text-overflow: clip; }
.loc-name-text { display: inline-block; }
.loc-name.has-overflow:hover .loc-name-text {
  animation: name-scroll 4s ease-in-out 0.2s infinite;
}
@keyframes name-scroll {
  0%,  12% { transform: translateX(0); }
  75%, 88% { transform: translateX(var(--name-overflow, 0px)); }
  100%     { transform: translateX(0); }
}
.loc-name .loc-num-prefix { color: rgba(255,255,255,0.55); font-weight: 600; }
.loc-name .loc-pipe       { color: rgba(255,255,255,0.3);  font-weight: 400; margin: 0 4px; }
.loc-city  { display: none; }
.loc-addr  { font-size: 11px; color: rgba(255,255,255,0.45); margin-top: 1px; white-space: nowraw; overflow: hidden; text-overflow: ellipsis; }
.loc-phone { font-size: 11px; color: rgba(255,255,255,0.45); margin-top: 1px; }
.loc-notes { font-size: 11px; color: rgba(255,255,255,0.5); margin-top: 4px; font-style: italic; line-height: 1.4; }
.loc-status { font-size: 10px; font-weight: 700; }
.loc-meta  { display: flex; align-items: center; gap: var(--s-1) var(--s-2); margin-top: var(--s-1); flex-wrap: wrap; }
.loc-opened { display: inline-flex; align-items: center; gap: 3px; padding: 0; font-size: 10px; color: rgba(255,255,255,0.55); }
/* Card action pills — one shape from the token scale; the variant
   classes below differ only in colour. */
.loc-maps, .loc-call, .loc-3d, .loc-cam, .loc-team {
  --ico-size: 1.05em;
  display: inline-flex; align-items: center; gap: var(--s-1);
  padding: 3px var(--s-2); border-radius: var(--r-sm);
  font-size: var(--f-2xs); font-weight: var(--w-semi); line-height: 1.6;
  font-family: inherit; white-space: nowrap; text-decoration: none;
  cursor: pointer; -webkit-appearance: none;
  transition: background var(--t-fast) var(--ease);
}

.loc-maps { background: rgba(245,200,0,0.15); color: var(--yellow); border: 1px solid rgba(245,200,0,0.25); }
.loc-maps:active { background: rgba(245,200,0,0.3); }
.loc-3d { background: rgba(167,139,250,0.15); color: #c4b5fd; border: 1px solid rgba(167,139,250,0.3); }
.loc-3d:active { background: rgba(167,139,250,0.3); }
.loc-cam { background: rgba(34,197,94,0.15); color: #4ade80; border: 1px solid rgba(34,197,94,0.3); }
.loc-cam:active { background: rgba(34,197,94,0.3); }
.loc-call { background: rgba(34,197,94,0.15); color: #4ade80; border: 1px solid rgba(34,197,94,0.3); }
.loc-call:active { background: rgba(34,197,94,0.3); }
.type-full { font-size: 9px; color: rgba(255,255,255,0.45); text-align: right; max-width: 80px; line-height: 1.2; }

/* ══ TEAM BUTTON ══════════════════════════════════════ */
.loc-team { background: rgba(255,255,255,0.1); color: rgba(255,255,255,0.7); border: 1px solid rgba(255,255,255,0.2); }
.loc-team:active { background: rgba(255,255,255,0.22); }

/* ══ HOURS ═══════════════════════════════════════════ */
.loc-hours { margin-top: 5px; }
.hw-hol { border-top: 1px solid rgba(255,255,255,0.12); margin-top: 3px; padding-top: 4px; }
.hw-hol .hw-day { color: var(--yellow); }
.hrs-toggle { display: inline-flex; align-items: center; gap: 5px; background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); border-radius: 5px; padding: 3px 8px; font-size: 10px; color: rgba(255,255,255,0.7); cursor: pointer; font-family: inherit; -webkit-appearance: none; }
.hrs-toggle:active { background: rgba(255,255,255,0.12); }
.hrs-dot { width: 7px; height: 7px; border-radius: 50%; flex-shrink: 0; display: inline-block; }
.hrs-dot.is-open { background: #22c55e; box-shadow: 0 0 5px rgba(34,197,94,0.75); }
.hrs-dot.is-closed { background: #ef4444; }
.hrs-state { font-weight: 800; }
.hrs-state.is-open { color: #4ade80; }
.hrs-state.is-closed { color: #f87171; }
.hrs-detail { color: rgba(255,255,255,0.55); }
.hrs-caret { color: rgba(255,255,255,0.4); transition: transform 0.18s; }
.loc-hours.open .hrs-caret { transform: rotate(180deg); }
.hrs-week { display: none; margin-top: 5px; padding: 6px 9px; background: rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.08); border-radius: 6px; max-width: 210px; }
.loc-hours.open .hrs-week { display: block; }
.hw-row { display: flex; justify-content: space-between; gap: 14px; font-size: 10px; line-height: 1.75; }
.hw-day { color: rgba(255,255,255,0.55); }
.hw-time { color: rgba(255,255,255,0.85); font-variant-numeric: tabular-nums; }
.hw-time.hw-closed { color: rgba(255,120,120,0.7); }

/* ══ GOOGLE RATING ═══════════════════════════════════ */
.loc-rating { display: inline-flex; align-items: center; gap: 3px; margin-top: 3px; font-size: 12.5px; font-weight: 800; line-height: 1; text-decoration: none; color: inherit; cursor: pointer; }
.rate-star  { color: #FFC107; font-size: 13px; }
.rate-num   { color: #fff; }
.rate-count { color: rgba(255,255,255,0.45); font-weight: 600; font-size: 10px; }
.rate-go    { color: rgba(255,255,255,0.35); font-size: 10px; font-weight: 700; }
.loc-rating:active { opacity: 0.65; }
@media (hover: hover) {
  .loc-rating:hover .rate-num { text-decoration: underline; }
  .loc-rating:hover .rate-go  { color: var(--yellow); }
}
.loc-rating.compact { margin-top: 0; font-size: 11px; vertical-align: middle; }
.loc-rating.compact .rate-star { font-size: 11px; }
.loc-rating.compact .rate-count { display: none; }

/* ══ PHOTOS ══════════════════════════════════════════ */
.photos { padding: 10px; display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }
.photo-slot {
  position: relative; border-radius: 9px; overflow: hidden;
  aspect-ratio: 4/3; background: rgba(0,0,0,0.25);
  border: 1.5px dashed rgba(255,255,255,0.18); cursor: pointer;
  transition: border-color 0.15s;
}
.photo-slot:active { opacity: 0.85; }
.photo-slot.has-photo { border-style: solid; border-color: rgba(255,255,255,0.1); }
/* object-position shifts the cover-crop right so the burned-in top-left
   number tag falls outside the thumbnail. The lightbox/slideshow use
   object-fit:contain, so they still show the full photo. */
.photo-slot img { width: 100%; height: 100%; object-fit: cover; object-position: 82% 50%; display: block; }
.photo-label { position: absolute; bottom: 0; left: 0; right: 0; padding: 14px 6px 5px; background: linear-gradient(transparent, rgba(0,0,0,.75)); font-size: 9px; color: rgba(255,255,255,0.85); text-transform: uppercase; letter-spacing: 0.5px; text-align: center; pointer-events: none; }

/* Marks not-yet-open locations as architectural renderings, not photos */
.photo-render-tag { position: absolute; top: 5px; right: 5px; padding: 2px 6px; border-radius: 4px; background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.28); font-size: 8px; font-weight: 800; letter-spacing: 0.7px; text-transform: uppercase; color: rgba(255,255,255,0.9); pointer-events: none; }
.ph { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; gap: 5px; position: absolute; inset: 0; }
.ph-icon { font-size: 24px; opacity: .2; }
.ph-text { font-size: 9px; color: rgba(255,255,255,0.35); text-align: center; padding: 0 8px; text-transform: uppercase; letter-spacing: 0.5px; line-height: 1.4; }

/* No results */
.no-results { display: none; text-align: center; padding: 60px 20px; color: rgba(255,255,255,0.4); }
.no-results.show { display: block; }
.no-results-icon { font-size: 38px; margin-bottom: 10px; }
.no-results p { font-size: 14px; }

/* ══ POLISHED ANIMATIONS ══════════════════════════════ */

/* — Card scroll entrance — */
@keyframes cardEnter {
  from { opacity: 0; transform: translateY(28px) scale(0.97); }
  to   { opacity: 1; transform: translateY(0)    scale(1);    }
}
.card-anim { opacity: 0; }
.card-anim.card-in {
  animation: cardEnter 0.52s cubic-bezier(0.22, 1, 0.36, 1) both;
  animation-delay: var(--card-delay, 0ms);
}

/* — Card hover lift (pointer devices only) — */
@media (hover: hover) {
  .card {
    transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.22s ease;
  }
  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 18px 52px rgba(0,0,0,.72), 0 0 0 1px rgba(250,220,0,0.1);
  }
  .card:active { transform: translateY(-2px) scale(0.99); }
}

/* — Photo slot image zoom on hover — */
.photo-slot img {
  transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}
@media (hover: hover) {
  .photo-slot:hover img { transform: scale(1.07); }
}

/* — Photo shimmer while loading — */
@keyframes shimmer {
  0%   { background-position: -600px 0; }
  100% { background-position:  600px 0; }
}
.photo-shimmer {
  background: linear-gradient(90deg,
    rgba(255,255,255,0.03) 0%,
    rgba(255,255,255,0.10) 45%,
    rgba(255,255,255,0.03) 90%);
  background-size: 600px 100%;
  animation: shimmer 1.6s ease-in-out infinite;
}

/* — Grid fade during filter / sort / search switch — */
#grid { transition: opacity 0.13s ease, transform 0.13s ease; }
#grid.fading { opacity: 0.18; transform: scale(0.983); pointer-events: none; }
</style>
