---
// Sticky search / brand filter / sort / view toggle bar, plus the count line under it.
---
<!-- ══ CONTROLS ════════════════════════════════════════ -->
<div class="controls">
  <div class="search-wrap">
    <span class="icon"><svg class="ico" aria-hidden="true"><use href="#i-search"></use></svg></span>
    <input type="search" id="search" placeholder="Search by name, city, number, or manager…" autocomplete="off" autocorrect="off">
    <button class="search-clear" id="searchClear" title="Clear"><svg class="ico" aria-hidden="true"><use href="#i-x"></use></svg></button>
  </div>
  <div class="filter-row" id="filterRow">
    <button class="filter-btn active" data-type="ALL">All</button>
    <button class="filter-btn" data-type="TLC">TLC — Lube Centers</button>
    <button class="filter-btn" data-type="TAS">TAS — Auto Spas</button>
    <button class="filter-btn" data-type="TAR">TAR — Auto Repair</button>
    <button class="filter-btn" data-type="TASE">TASe — Expresses</button>
  </div>
  <div class="sort-row">
    <span class="sort-label">Sort:</span>
    <button class="sort-btn active" data-sort="num">By #</button>
    <button class="sort-btn" data-sort="date">By Date</button>
    <button class="sort-btn" data-sort="state">By State</button>
    <button class="sort-btn" data-sort="rating"><svg class="ico ico--fill" aria-hidden="true"><use href="#i-star"></use></svg>Top Rated</button>
    <select class="state-select" id="stateSelect">
      <option value="">All States</option>
      <option value="MD">MD</option>
      <option value="PA">PA</option>
      <option value="WV">WV</option>
    </select>
    <div class="view-toggle" id="viewToggle">
      <button class="view-btn active" data-view="grid" title="Grid view"><svg class="ico" aria-hidden="true"><use href="#i-grid"></use></svg>Grid</button>
      <button class="view-btn" data-view="map" title="Map view"><svg class="ico" aria-hidden="true"><use href="#i-map"></use></svg>Map</button>
      <button class="view-btn" data-view="timeline" title="Growth timeline"><svg class="ico" aria-hidden="true"><use href="#i-trend"></use></svg>Growth</button>
    </div>
  </div>
</div>

<div class="stats-bar" id="statsBar"></div>

<style is:global>
/* ══ CONTROLS ════════════════════════════════════════ */
.controls {
  background: var(--mid);
  padding: 10px 14px 8px;
  position: sticky; top: 58px; z-index: 190;
  border-bottom: 1px solid rgba(255,255,255,0.1);
  box-shadow: 0 2px 10px rgba(0,0,0,.25);
}
.search-wrap { position: relative; margin-bottom: 8px; }
.search-wrap input {
  width: 100%; padding: 8px 36px 8px 34px;
  background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2);
  border-radius: 10px; color: #fff; font-size: 14px; outline: none; -webkit-appearance: none;
}
.search-wrap input::placeholder { color: rgba(255,255,255,0.45); }
.search-wrap input:focus { background: rgba(255,255,255,0.18); border-color: var(--yellow); }
.search-wrap .icon { position: absolute; left: var(--s-3); top: 50%; transform: translateY(-50%); display: flex; font-size: var(--f-md); color: rgba(255,255,255,0.45); pointer-events: none; }
.search-clear { position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; color: rgba(255,255,255,0.5); cursor: pointer; font-size: 16px; display: none; padding: 2px; }

.filter-row { display: flex; gap: 6px; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; padding-bottom: 2px; }
.filter-row::-webkit-scrollbar { display: none; }
.filter-btn {
  flex-shrink: 0; padding: var(--s-1) var(--s-3); border-radius: var(--r-full);
  border: 1.5px solid rgba(255,255,255,0.15); background: #000;
  color: rgba(255,255,255,0.7); font-size: 12px; font-weight: 700;
  cursor: pointer; transition: all 0.18s; white-space: nowrap; -webkit-appearance: none;
}
.filter-btn.active                { color: var(--deep); border-color: transparent; }
.filter-btn[data-type="ALL"].active  { background: rgba(255,255,255,0.9); }
.filter-btn[data-type="TLC"].active  { background: var(--tlc-c); }
.filter-btn[data-type="TAS"].active  { background: var(--tas-c); }
.filter-btn[data-type="TAR"].active  { background: var(--tar-c); }
.filter-btn[data-type="TASE"].active { background: var(--tase-c); }

.sort-row { display: flex; align-items: center; gap: 6px; margin-top: 8px; flex-wrap: wrap; row-gap: 7px; }
.sort-label { font-size: 10px; color: rgba(255,255,255,0.45); text-transform: uppercase; letter-spacing: 1px; flex-shrink: 0; }
.sort-btn { display: inline-flex; align-items: center; gap: var(--s-1); padding: var(--s-1) var(--s-3); border-radius: var(--r-sm); border: 1px solid rgba(255,255,255,0.15); background: #000; color: rgba(255,255,255,0.6); font-size: var(--f-xs); cursor: pointer; -webkit-appearance: none; transition: background var(--t-fast) var(--ease), color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease); }
.sort-btn.active { background: #000; color: #fff; border-color: rgba(255,255,255,0.5); }
.state-select { display: none; padding: 3px 8px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.3); background: #000; color: #fff; font-size: 11px; font-weight: 700; cursor: pointer; -webkit-appearance: none; outline: none; }
.state-select.show { display: block; }
.state-select option { background: #0d3268; color: #fff; }

.stats-bar { padding: 6px 14px; background: rgba(255,255,255,0.05); font-size: 11px; color: rgba(255,255,255,0.45); border-bottom: 1px solid rgba(255,255,255,0.07); }

/* Clamp sticky control bar's inner elements so the search input doesn't stretch edge-to-edge on wide monitors */
@media(min-width: 1100px) {
  .controls > .search-wrap,
  .controls > .filter-row,
  .controls > .sort-row,
  .stats-bar { max-width: 1320px; margin-left: auto; margin-right: auto; }
}
@media(min-width: 1500px) {
  .controls > .search-wrap,
  .controls > .filter-row,
  .controls > .sort-row,
  .stats-bar { max-width: 1720px; }
}

/* Grid / Map / Growth switch */
.view-toggle { display: flex; border: 1px solid rgba(255,255,255,0.25); border-radius: 8px; overflow: hidden; flex-shrink: 0; }
@media(min-width: 560px) { .view-toggle { margin-left: auto; } }
.view-btn {
  display: inline-flex; align-items: center; gap: var(--s-1);
  padding: var(--s-1) var(--s-3); border: none; background: #000;
  color: rgba(255,255,255,0.6); font-size: var(--f-xs); font-weight: var(--w-bold);
  cursor: pointer; -webkit-appearance: none;
  transition: background var(--t-fast) var(--ease), color var(--t-fast) var(--ease);
}
.view-btn + .view-btn { border-left: 1px solid rgba(255,255,255,0.25); }
.view-btn.active { background: var(--yellow); color: var(--deep); }

/* — Filter button tap pop — */
@keyframes filterPop {
  0%   { transform: scale(1); }
  35%  { transform: scale(0.86); }
  68%  { transform: scale(1.12); }
  100% { transform: scale(1); }
}
.filter-btn.pop { animation: filterPop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); }

/* — Search input focus glow — */
.search-wrap input {
  transition: background 0.2s, border-color 0.2s, box-shadow 0.2s;
}
.search-wrap input:focus {
  box-shadow: 0 0 0 3px rgba(250,220,0,0.14);
}
</style>
