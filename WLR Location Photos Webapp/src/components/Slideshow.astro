---
// Auto-advancing full-screen slideshow; scripts/slideshow.js drives it.
---
<!-- ══ SLIDESHOW ═══════════════════════════════════════ -->
<div class="slideshow" id="slideshow">
  <div class="ss-progress"><div class="ss-progress-fill" id="ssProgressFill"></div></div>
  <div class="ss-photo-wrap" id="ssPhotoWrap">
    <img id="ssPhoto" src="" alt="">
    <div class="ss-info" id="ssInfo"></div>
  </div>
  <button class="ss-close-btn" id="ssClose"><svg class="ico" aria-hidden="true"><use href="#i-x"></use></svg></button>
  <div class="ss-controls">
    <button class="ss-btn" id="ssPrev">‹</button>
    <div style="flex:1;text-align:center">
      <div class="ss-counter" id="ssCounter"></div>
      <div class="ss-photo-label" id="ssPhotoLabel"></div>
    </div>
    <button class="ss-btn" id="ssPause" title="Pause"><svg class="ico ico--fill" aria-hidden="true"><use href="#i-pause"></use></svg></button>
    <div style="width:10px"></div>
    <button class="ss-btn" id="ssNext">›</button>
  </div>
</div>

<style is:global>
/* ══ SLIDESHOW ════════════════════════════════════════ */
.slideshow {
  display: none; position: fixed; inset: 0;
  background: linear-gradient(160deg, #0c2c5a 0%, #071a38 100%); z-index: 900;
  flex-direction: column;
}
.slideshow.open { display: flex; }

/* Progress bar */
.ss-progress { height: 3px; background: rgba(255,255,255,0.15); position: relative; flex-shrink: 0; }
.ss-progress-fill { height: 100%; background: var(--yellow); width: 0%; transition: none; }

/* Photo area */
.ss-photo-wrap { flex: 1; display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative; }
.ss-photo-wrap img { max-width: 100%; max-height: 100%; object-fit: contain; }
.ss-photo-wrap .ss-no-photo { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; color: rgba(255,255,255,0.3); }
.ss-no-photo-icon { font-size: 48px; opacity: 0.3; }
.ss-no-photo-text { font-size: 14px; text-transform: uppercase; letter-spacing: 1px; }

/* Info overlay at bottom */
.ss-info {
  background: linear-gradient(transparent, rgba(0,0,0,0.9));
  padding: 40px 20px 20px;
  position: absolute; bottom: 0; left: 0; right: 0;
  pointer-events: none;
}
.ss-type-badge { display: inline-flex; padding: 3px 10px; border-radius: 6px; font-size: 11px; font-weight: 800; color: var(--deep); margin-bottom: 6px; }
.ss-loc-num  { font-size: 13px; color: rgba(255,255,255,0.5); margin-bottom: 2px; }
.ss-loc-name { font-size: 22px; font-weight: 800; color: #fff; line-height: 1.2; }
.ss-loc-city { font-size: 14px; color: rgba(255,255,255,0.7); margin-top: 3px; }
.ss-opened   { font-size: 12px; color: rgba(255,255,255,0.45); margin-top: 4px; }

/* Slideshow controls */
.ss-controls {
  display: flex; align-items: center; justify-content: space-between;
  padding: 12px 16px max(env(safe-area-inset-bottom), 12px);
  background: rgba(0,0,0,0.9); flex-shrink: 0; gap: 10px;
}
.ss-btn {
  width: 44px; height: 44px; border-radius: 50%;
  background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
  color: #fff; font-size: 18px; cursor: pointer;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.ss-btn:active { background: rgba(255,255,255,0.25); }
.ss-counter    { font-size: 13px; color: rgba(255,255,255,0.55); text-align: center; flex: 1; }
.ss-photo-label { font-size: 11px; color: rgba(255,255,255,0.4); text-align: center; }
.ss-close-btn {
  position: absolute; top: max(env(safe-area-inset-top), 14px); right: 14px;
  width: 40px; height: 40px; border-radius: 50%;
  background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);
  color: #fff; font-size: 18px; cursor: pointer;
  display: flex; align-items: center; justify-content: center; z-index: 10;
}
</style>
