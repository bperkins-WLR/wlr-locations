---
// Scroll-to-top button, brand legend, admin link and build stamp.
---
<!-- ══ SCROLL TOP / FOOTER ══════════════════════════════ -->
<button class="scroll-top" id="scrollTop"><svg class="ico" aria-hidden="true"><use href="#i-arrow-up"></use></svg></button>

<footer>
  <div class="legend">
    <div class="legend-item"><div class="legend-dot" style="background:var(--tlc-c)"></div>TLC</div>
    <div class="legend-item"><div class="legend-dot" style="background:var(--tas-c)"></div>TAS</div>
    <div class="legend-item"><div class="legend-dot" style="background:var(--tar-c)"></div>TAR</div>
    <div class="legend-item"><div class="legend-dot" style="background:var(--tase-c)"></div>TASe</div>
    <div class="legend-item" style="margin-left:8px">
      <a href="admin.html" style="color:rgba(255,255,255,0.2);font-size:10px;text-decoration:none"><svg class="ico" aria-hidden="true"><use href="#i-settings"></use></svg></a>
    </div>
  </div>
  <button class="build-stamp" id="buildStamp" title="Which build this device is running. Tap to force a fresh copy.">
  </button>
</footer>

<style is:global>
/* ══ FOOTER ══════════════════════════════════════════ */
footer {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: rgba(10,27,75,0.97);
  /* Prefixed first — see the note in TeamModal.astro. */
  -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
  padding: 8px 16px max(env(safe-area-inset-bottom), 8px);
  text-align: center; border-top: 1px solid rgba(255,255,255,0.1);
}
.legend { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
.legend-item { display: flex; align-items: center; gap: 4px; font-size: 10px; color: rgba(255,255,255,0.5); }
.legend-dot  { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
/* Build stamp — deliberately quiet. Its job is to answer "which version is
   this phone on?" without drawing the eye during a demo. */
.build-stamp {
  display: block; margin: 3px auto 0; padding: 2px 6px;
  background: none; border: none; font-family: inherit;
  font-size: 9px; letter-spacing: 0.4px; color: rgba(255,255,255,0.25);
  cursor: pointer; -webkit-appearance: none;
  font-variant-numeric: tabular-nums;
}
.build-stamp:active { color: rgba(255,255,255,0.6); }

.scroll-top {
  position: fixed; bottom: 56px; right: 16px;
  width: 38px; height: 38px; border-radius: 50%;
  background: var(--yellow); border: none; color: var(--deep);
  font-size: 18px; font-weight: 900; cursor: pointer;
  display: none; align-items: center; justify-content: center;
  box-shadow: 0 3px 12px rgba(0,0,0,.4); z-index: 150;
}
.scroll-top.show { display: flex; }
</style>
